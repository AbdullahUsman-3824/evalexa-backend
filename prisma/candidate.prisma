model Candidate {
  id           String            @id @default(uuid()) @db.Uuid
  fullName     String            @map("full_name") @db.VarChar(255)
  email        String?           @db.VarChar(255)
  phone        String?           @db.VarChar(50)
  linkedinUrl  String?           @map("linkedin_url") @db.VarChar(255)
  portfolioUrl String?           @map("portfolio_url") @db.VarChar(255)
  location     String?           @db.VarChar(255)
  resumes      Resume[]
  applications Application[]
  createdAt    DateTime          @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime          @map("updated_at") @updatedAt @db.Timestamptz(6)

  @@map("candidate")
}