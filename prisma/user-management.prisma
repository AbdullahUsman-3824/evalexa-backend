model User {
  id               String            @id @default(uuid()) @db.Uuid
  // publicId         String    @unique @default(uuid()) @db.Uuid
  fullName         String            @db.VarChar(150)
  email            String            @unique @db.VarChar(255)
  password         String            @db.VarChar(255)
  phone            String            @db.VarChar(30)
  role             String            @default("recruiter") @db.VarChar(50)
  companyId        String?           @db.Uuid
  company          Company?          @relation("CompanyMembers", fields: [companyId], references: [id], onDelete: SetNull)
  passwordResetOtp PasswordResetOtp?
  isVerified       Boolean           @default(false)
  isActive         Boolean           @default(true)
  lastLogin        DateTime?         @db.Timestamptz(6)
  createdCompanies Company[]         @relation("CompanyCreator")
  createdJobs      Job[]             @relation("UserCreatedJobs")
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)

  @@map("users")
}

model PendingUserRegistration {
  id                   String                @id @default(uuid()) @db.Uuid
  fullName             String                @db.VarChar(150)
  email                String                @unique @db.VarChar(255)
  passwordHash         String                @db.VarChar(255)
  phone                String                @db.VarChar(30)
  role                 String                @default("recruiter") @db.VarChar(50)
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(6)
  emailVerificationOtp EmailVerificationOtp?

  @@map("pending_user_registrations")
}

model EmailVerificationOtp {
  id                        String                  @id @default(uuid()) @db.Uuid
  pendingUserRegistrationId String                  @unique @db.Uuid
  otpHash                   String                  @db.VarChar(255)
  expiresAt                 DateTime                @db.Timestamptz(6)
  createdAt                 DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                @updatedAt @db.Timestamptz(6)
  pendingUserRegistration   PendingUserRegistration @relation(fields: [pendingUserRegistrationId], references: [id], onDelete: Cascade)

  @@map("email_verification_otps")
}

model PasswordResetOtp {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  otpHash   String   @db.VarChar(255)
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_otps")
}

model Company {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(150)
  slug         String        @unique @db.VarChar(180)
  logo         String?       @db.VarChar(500)
  industry     String        @db.VarChar(100)
  companySize  String        @db.VarChar(50)
  website      String?       @db.VarChar(255)
  location     String        @db.VarChar(255)
  description  String?
  createdBy    String        @db.Uuid
  creator      User          @relation("CompanyCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  users        User[]        @relation("CompanyMembers")
  jobs         Job[]
  applications Application[]
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)

  @@map("companies")
}
