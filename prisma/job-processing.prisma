model JobProcessing {
    id String @id @default(uuid()) @db.Uuid

    jobId String @unique @map("job_id") @db.Uuid

    status      ProcessingStatus    @default(PENDING)
    currentTask ProcessingTaskType?

    totalApplications     Int @default(0) @map("total_applications")
    processedApplications Int @default(0) @map("processed_applications")
    failedApplications    Int @default(0) @map("failed_applications")

    startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
    completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

    retryCount Int   @default(0) @map("retry_count")
    lastError  Json? @map("last_error")

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

    job   Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
    tasks ProcessingTask[]

    @@index([status])
    @@map("job_processing")
}