model ProcessingTask {
    id String @id @default(uuid()) @db.Uuid

    jobProcessingId String @map("job_processing_id") @db.Uuid

    applicationId String? @map("application_id") @db.Uuid

    scope    TaskScope
    taskType ProcessingTaskType
    status   ProcessingStatus   @default(PENDING)

    startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
    completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

    retryCount Int   @default(0) @map("retry_count")
    error      Json?

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

    jobProcessing JobProcessing @relation(fields: [jobProcessingId], references: [id], onDelete: Cascade)
    application   Application?  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

    @@index([jobProcessingId])
    @@index([applicationId, taskType])
    @@map("processing_tasks")
}