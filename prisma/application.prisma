model Application {
  id                String            @id @default(uuid()) @db.Uuid
  candidateId       String            @map("candidate_id") @db.Uuid
  jobId             String            @map("job_id") @db.Uuid
  companyId         String            @map("company_id") @db.Uuid
  resumeId          String            @map("resume_id") @db.Uuid
  source            ApplicationSource @default(FORM_FILL)
  status            ApplicationStatus @default(APPLIED)
  matchScore        Int?              @map("match_score")
  rankPosition      Int?              @map("rank_position")
  isAutoShortlisted Boolean           @default(false) @map("is_auto_shortlisted")
  appliedAt         DateTime          @default(now()) @map("applied_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  candidate             Candidate              @relation(fields: [candidateId], references: [id])
  company               Company                @relation(fields: [companyId], references: [id])
  job                   Job                    @relation(fields: [jobId], references: [id])
  resume                Resume                 @relation(fields: [resumeId], references: [id])
  resumeAnalyses        ResumeAnalysis[]
  applicationProcessing ApplicationProcessing?
  interviews            Interview[]
  offers                Offer[]

  @@index([candidateId])
  @@index([jobId])
  @@index([companyId])
  @@index([resumeId])
  @@index([jobId, rankPosition])
  @@index([jobId, matchScore])
  @@map("application")
}
