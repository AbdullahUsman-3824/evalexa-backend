model ResumeAnalysis {
  id              String               @id @default(uuid()) @db.Uuid
  applicationId   String               @map("application_id") @db.Uuid
  jobId           String               @map("job_id") @db.Uuid
  skillMatchScore Int?                 @map("skill_match_score")
  experienceScore Int?                 @map("experience_score")
  educationScore  Int?                 @map("education_score")
  overallScore    Int?                 @map("overall_score")
  matchedSkills   Json?                @map("matched_skills")
  missingSkills   Json?                @map("missing_skills")
  strengths       Json?
  weaknesses      Json?
  aiSummary       String?              @map("ai_summary")
  recommendation  MatchRecommendation?
  modelVersion    String?              @map("model_version") @db.VarChar(50)
  analysisVersion Int                  @default(1) @map("analysis_version")
  isLatest        Boolean              @default(true) @map("is_latest") 
  analyzedAt      DateTime             @default(now()) @map("analyzed_at") @db.Timestamptz(6)
  application     Application          @relation(fields: [applicationId], references: [id])
  job             Job                  @relation(fields: [jobId], references: [id])

  @@unique([applicationId, analysisVersion])
  @@index([applicationId])
  @@index([jobId])
  @@index([applicationId, isLatest])
  @@map("resume_analysis")
}

enum MatchRecommendation {
  STRONG_MATCH  @map("strong_match")
  GOOD_MATCH    @map("good_match")
  AVERAGE_MATCH @map("average_match")
  WEAK_MATCH    @map("weak_match")
}
