model Job {
  id                  String           @id @default(uuid()) @db.Uuid
  companyId           String           @db.Uuid
  createdBy           String           @db.Uuid
  title               String           @db.VarChar(255)
  description         String
  jobType             JobType
  experienceLevel     ExperienceLevel
  salaryMin           Int
  salaryMax           Int
  location            String           @db.VarChar(255)
  workModel           WorkModel
  status              JobStatus        @default(DRAFT)
  applicationDeadline DateTime         @db.Date
  createdAt           DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(6)
  slug                String           @unique @db.VarChar(350)
  educationLevel      EducationLevel   @default(ANY)
  responsibilities    String
  salaryCurrency      String           @default("PKR")
  salaryPeriod        SalaryPeriod
  department          String           @db.VarChar(255)
  applications        Application[]
  aiConfig            JobAiConfig?
  jobSkills           JobSkill[]
  company             Company          @relation(fields: [companyId], references: [id])
  creator             User             @relation("UserCreatedJobs", fields: [createdBy], references: [id])
  resumeAnalyses      ResumeAnalysis[]

  @@index([companyId])
  @@index([createdBy])
  @@index([status])
  @@map("jobs")
}

model Skill {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique @db.VarChar(150)
  category  String     @db.VarChar(100)
  jobSkills JobSkill[]

  @@map("skills")
}

model JobSkill {
  jobId      String          @map("job_id") @db.Uuid
  skillId    String          @map("skill_id") @db.Uuid
  importance SkillImportance
  weight     Int
  job        Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill      Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@map("job_skills")
}

model JobAiConfig {
  id                      String   @id @default(uuid()) @db.Uuid
  jobId                   String   @unique @db.Uuid
  enableAutoShortlist     Boolean
  enableAiInterview       Boolean
  createdAt               DateTime @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @db.Timestamptz(6)
  interviewSelectionCount Int
  resumeSelectionCount    Int
  job                     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_ai_config")
}

enum JobType {
  FULL_TIME @map("full-time")
  PART_TIME @map("part-time")
  CONTRACT  @map("contract")
}

enum ExperienceLevel {
  JUNIOR @map("junior")
  MID    @map("mid")
  SENIOR @map("senior")
  LEAD   @map("lead")
}

enum EducationLevel {
  HIGH_SCHOOL @map("high_school")
  BACHELOR    @map("bachelor")
  MASTER      @map("master")
  PHD         @map("phd")
  ANY         @map("any")
}

enum WorkModel {
  REMOTE @map("remote")
  HYBRID @map("hybrid")
  ONSITE @map("onsite")
}

enum SalaryPeriod {
  MONTHLY @map("monthly")
  YEARLY  @map("yearly")
}

enum JobStatus {
  OPEN   @map("open")
  CLOSED @map("closed")
  DRAFT  @map("draft")
}

enum SkillImportance {
  REQUIRED  @map("required")
  PREFERRED @map("preferred")
}
