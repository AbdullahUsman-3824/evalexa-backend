model Job {
  id String @id @default(uuid()) @db.Uuid

  companyId String @db.Uuid
  createdBy String @db.Uuid

  // Basic Information
  title       String @db.VarChar(255)
  slug        String @unique @db.VarChar(350)
  description String

  department String? @db.VarChar(150)

  // Employment
  jobType   JobType
  workModel WorkModel

  experienceLevel ExperienceLevel
  educationLevel  EducationLevel  @default(ANY)

  // Salary
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String        @default("PKR") @db.VarChar(10)
  salaryPeriod   SalaryPeriod?

  // Location
  location String? @db.VarChar(255)

  // Hiring
  status JobStatus @default(DRAFT)

  applicationDeadline DateTime? @db.Date

  totalOpenings Int @default(1)

  // Audit
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  company Company @relation(fields: [companyId], references: [id])

  creator User @relation("UserCreatedJobs", fields: [createdBy], references: [id])

  applications   Application[]
  aiConfig       JobAiConfig?
  resumeAnalyses ResumeAnalysis[]

  jobProcessing JobProcessing? 
  jobSkills JobSkill[]

  @@index([companyId])
  @@index([createdBy])
  @@index([status])
  @@index([applicationDeadline])
  @@map("jobs")
}

model Skill {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique @db.VarChar(150)
  category  String     @db.VarChar(100)
  jobSkills JobSkill[]

  @@map("skills")
}

model JobSkill {
  jobId      String          @map("job_id") @db.Uuid
  skillId    String          @map("skill_id") @db.Uuid
  importance SkillImportance
  weight     Int
  job        Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill      Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@map("job_skills")
}

model JobAiConfig {
  id                      String    @id @default(uuid()) @db.Uuid

  jobId                   String    @unique @db.Uuid

  // Resume Ranking
  enableRanking           Boolean   @default(true)

  // Automatically shortlist top candidates
  enableAutoShortlisting  Boolean   @default(true)

  // Number of candidates to shortlist
  shortlistLimit          Int?

  // Minimum AI score required
  minimumMatchScore       Float?

  // AI Interview
  enableAiInterview       Boolean   @default(false)

  // Invite only top N candidates
  interviewLimit          Int?

  createdAt               DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(6)

  job                     Job       @relation( fields: [jobId],references: [id],onDelete: Cascade)

  @@map("job_ai_config")
}
